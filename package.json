{
	"type": "module",
	"private": true,
	"license": "MIT",
	"description": "HTML tags, just truly accessible",
	"workspaces": [
		"packages/*"
	],
	"homepage": "https://u-elements.github.io/u-elements/",
	"repository": {
		"type": "git",
		"url": "https://github.com/u-elements/u-elements.git"
	},
	"bugs": {
		"url": "https://github.com/u-elements/u-elements/issues"
	},
	"scripts": {
		"build": "npm run build --workspaces",
		"docs:build": "npm run build && vitepress build docs",
		"docs:dev": "npm run build && vitepress dev docs",
		"docs:preview": "vitepress preview docs",
		"lint": "npx @biomejs/biome check",
		"prepublishOnly": "npm run build",
		"dev:build": "vite build",
		"dev": "vite",
		"dev:preact": "vite --config=frameworks/preact/vite.config.ts",
		"dev:qwik": "vite --config=frameworks/qwik/vite.config.ts",
		"dev:react": "vite --config=frameworks/react/vite.config.ts",
		"dev:solid": "vite --config=frameworks/solid/vite.config.ts",
		"dev:svelte": "vite --config=frameworks/svelte/vite.config.ts",
		"dev:vue": "vite --config=frameworks/vue/vite.config.ts",
		"test": "playwright test",
		"test:update": "npm run test -- --update-snapshots"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@custom-elements-manifest/analyzer": "0.11.0",
		"@mdn/browser-compat-data": "8.0.10",
		"@playwright/test": "1.62.1",
		"@preact/preset-vite": "2.10.6",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tsconfig/svelte": "5.0.8",
		"@types/caniuse-lite": "1.0.5",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"@vitejs/plugin-vue": "6.0.8",
		"@vue/runtime-dom": "3.5.41",
		"caniuse-lite": "1.0.30001809",
		"custom-element-vs-code-integration": "1.5.0",
		"jshint": "2.13.6",
		"prettier": "3.9.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"solid-js": "1.9.14",
		"svelte": "5.56.9",
		"svelte-check": "4.7.6",
		"tslib": "2.8.1",
		"tsup": "8.5.1",
		"typescript": "6.0.2",
		"vite": "8.2.1",
		"vite-plugin-cem": "0.8.5",
		"vite-plugin-solid": "2.11.14",
		"vitepress": "2.0.0-alpha.17",
		"vue": "3.5.41",
		"vue-tsc": "3.3.9"
	},
	"overrides": {
		"ansi-regex": "^6.2.2",
		"ansi-styles": "^6.2.3",
		"chalk": "^5.6.2",
		"debug": "^4.4.3",
		"esbuild": "^0.28.1",
		"glob": "^13.0.6",
		"lodash": "^4.18.1",
		"minimatch": "^10.2.5",
		"seroval": "^1.4.1",
		"strip-ansi": "^7.1.2",
		"supports-color": "^10.2.2",
		"tmp": "^0.2.5",
		"wrap-ansi": "^9.0.1"
	}
}
