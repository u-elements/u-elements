{
	"type": "module",
	"private": true,
	"license": "MIT",
	"description": "HTML tags, just truly accessible",
	"workspaces": [
		"packages/*"
	],
	"homepage": "https://u-elements.github.io/u-elements/",
	"repository": {
		"type": "git",
		"url": "https://github.com/u-elements/u-elements.git"
	},
	"bugs": {
		"url": "https://github.com/u-elements/u-elements/issues"
	},
	"scripts": {
		"build": "npm run build --workspaces",
		"docs:build": "npm run build && vitepress build docs",
		"docs:dev": "npm run build && vitepress dev docs",
		"docs:preview": "vitepress preview docs",
		"lint": "npx @biomejs/biome check",
		"typecheck": "npm run build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p frameworks/vanilla/tsconfig.json && tsc --noEmit -p frameworks/react/tsconfig.json && tsc --noEmit -p frameworks/angular/tsconfig.json && vue-tsc --noEmit -p frameworks/vue/tsconfig.json && svelte-check --tsconfig frameworks/svelte/tsconfig.json && tsc --noEmit -p frameworks/solid/tsconfig.json && tsc --noEmit -p frameworks/qwik/tsconfig.json && tsc --noEmit -p frameworks/preact/tsconfig.json",
		"prepublishOnly": "npm run build",
		"dev:build": "vite build",
		"dev": "vite",
		"dev:preact": "vite --config=frameworks/preact/vite.config.ts",
		"dev:qwik": "vite --config=frameworks/qwik/vite.config.ts",
		"dev:react": "vite --config=frameworks/react/vite.config.ts",
		"dev:solid": "vite --config=frameworks/solid/vite.config.ts",
		"dev:svelte": "vite --config=frameworks/svelte/vite.config.ts",
		"dev:vue": "vite --config=frameworks/vue/vite.config.ts",
		"dev:angular": "vite --config=frameworks/angular/vite.config.ts",
		"test": "playwright test",
		"test:frameworks": "playwright test --project=React --project=Vue --project=Svelte --project=Angular --project=Solid --project=Qwik --project=Preact",
		"test:vanilla": "playwright test --project=Chromium --project=Firefox --project=Webkit --project=\"Microsoft Edge\" --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
		"test:update": "npm run test -- --update-snapshots"
	},
	"devDependencies": {
		"@angular/common": "22.2.3",
		"@angular/compiler": "22.2.3",
		"@angular/core": "22.2.3",
		"@angular/forms": "22.2.3",
		"@angular/platform-browser": "22.2.3",
		"@biomejs/biome": "2.6.3",
		"@custom-elements-manifest/analyzer": "0.11.0",
		"@mdn/browser-compat-data": "8.1.7",
		"@playwright/test": "1.64.1",
		"@preact/preset-vite": "2.10.6",
		"@qwik.dev/core": "2.0.0-rc.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tsconfig/svelte": "5.0.8",
		"@types/caniuse-lite": "1.0.5",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/runtime-dom": "3.5.44",
		"caniuse-lite": "1.0.30001819",
		"custom-element-vs-code-integration": "1.5.0",
		"jshint": "2.13.6",
		"preact": "11.1.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rxjs": "7.8.2",
		"solid-js": "1.9.17",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tslib": "2.8.1",
		"tsup": "9.0.0",
		"typescript": "^6.0.2",
		"vite": "8.3.5",
		"vite-plugin-cem": "0.8.5",
		"vite-plugin-solid": "2.11.14",
		"vitepress": "2.0.0-alpha.20",
		"vue": "3.5.44",
		"vue-tsc": "3.3.13"
	},
	"overrides": {
		"@babel/plugin-transform-runtime": "^7.29.0",
		"ansi-regex": "^6.2.2",
		"ansi-styles": "^6.2.3",
		"chalk": "^5.6.2",
		"debug": "^4.4.3",
		"esbuild": "^0.28.1",
		"glob": "^13.0.6",
		"lodash": "^4.18.1",
		"minimatch": "^10.2.5",
		"seroval": "^1.4.1",
		"strip-ansi": "^7.1.2",
		"supports-color": "^10.2.2",
		"tmp": "^0.2.5",
		"wrap-ansi": "^9.0.1"
	}
}
